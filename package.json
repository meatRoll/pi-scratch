{
	"name": "pi-scratch",
	"version": "1.0.1",
	"description": "Pi extension: summon a throwaway terminal for ad-hoc commands",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"terminal",
		"shell",
		"scratch"
	],
	"type": "module",
	"license": "MIT",
	"author": "meatRoll",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meatRoll/pi-scratch.git"
	},
	"homepage": "https://github.com/meatRoll/pi-scratch#readme",
	"bugs": {
		"url": "https://github.com/meatRoll/pi-scratch/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"index.ts",
		"README.md",
		"README.zh-CN.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test tests/*.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.9.3"
	}
}
